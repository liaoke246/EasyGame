[Unit]
Description=EasyGame Dead Rails Mirror server
After=network.target

[Service]
Type=simple
User=easygame
Group=easygame
WorkingDirectory=/srv/easygame/current/unity-side-scroller/PrebuiltServerLinux
ExecStart=/srv/easygame/current/unity-side-scroller/PrebuiltServerLinux/DeadRailsServer.x86_64 -batchmode -nographics -logFile -
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
