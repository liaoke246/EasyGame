{
  "name": "easygame",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "build:web-release": "node scripts/assemble-web-release.mjs",
    "start": "npm run start -w server",
    "test:animation": "node scripts/animation-invariant-test.mjs",
    "test:combat": "node scripts/combat-geometry-test.mjs",
    "test:unity": "node scripts/unity-project-test.mjs",
    "test:side-scroller": "node scripts/side-scroller-project-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
